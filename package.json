  "devDependencies": {
    "@parcel/transformer-sass": "2.15.4",
    "autoprefixer": "^10.4.21",
    "breakpoint-sass": "^3.0.0",
    "cssnano": "^7.1.1",
    "minimist": "^1.2.8",
    "parcel": "^2.15.4",
    "postcss": "^8.5.6",
    "postcss-modules": "^6.0.1",
    "posthtml": "^0.16.6",
